# Podfile for the Fridgey iOS app.
#
# After modifying this file run:
#   cd iosApp
#   pod install --repo-update
#   open iosApp.xcworkspace   # NOT iosApp.xcodeproj
#
# These pods are linked from Swift only (the Swift bridges in iosApp/Auth/).
# The Kotlin shared framework calls into Firebase via the gitlive Kotlin SDK,
# whose iOS implementation references the Firebase iOS symbols that get
# resolved at link time when the app is built against these pods.

platform :ios, '15.0'

target 'iosApp' do
  use_frameworks!

  # Firebase Authentication — backs everything in shared/AuthRepository.
  pod 'FirebaseAuth'

  # Cloud Firestore — backs the SHARED-fridge sync in shared (gitlive
  # firebase-firestore); like FirebaseAuth, its FIR* symbols resolve at
  # app link time against this pod. Unpinned on purpose: the resolver
  # keeps it on the same Firebase release train as FirebaseAuth via
  # their common FirebaseCore constraint.
  pod 'FirebaseFirestore'

  # Native Google Sign-In SDK — used by GoogleSignInBridge.swift to
  # produce an idToken that we hand to Firebase.
  pod 'GoogleSignIn'

  # Firebase Cloud Messaging — el token FCM nace aquí (gitlive NO cubre
  # Messaging). AppDelegate enlaza APNs↔FCM (swizzling OFF) y cruza el token al
  # shared module, que escribe usuarios/{uid}/tokens/{idInstalacion} (HITO 5).
  pod 'FirebaseMessaging'
end
