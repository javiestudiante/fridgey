CREATE TABLE IF NOT EXISTS Nevera (
    id TEXT NOT NULL PRIMARY KEY,
    nombre TEXT NOT NULL,
    id_propietario TEXT NOT NULL,
    fecha_creacion INTEGER NOT NULL,  -- Unix timestamp (seconds)
    modo TEXT NOT NULL DEFAULT 'LOCAL',  -- ModoNevera.valor: 'LOCAL' | 'SHARED'
    updated_at INTEGER,  -- último serverTimestamp de Firestore aplicado (epoch seconds); NULL si nunca sincronizada
    FOREIGN KEY (id_propietario) REFERENCES Usuario(id) ON DELETE CASCADE
);

selectAll:
SELECT * FROM Nevera;

-- Returns all fridges accessible to a user (owned + collaborated)
selectByUsuario:
SELECT DISTINCT n.*
FROM Nevera n
LEFT JOIN NeveraColaborador nc ON n.id = nc.id_nevera
WHERE n.id_propietario = :usuarioId
   OR nc.id_usuario = :usuarioId
ORDER BY n.fecha_creacion DESC;

selectById:
SELECT * FROM Nevera WHERE id = ?;

insert:
INSERT INTO Nevera (id, nombre, id_propietario, fecha_creacion)
VALUES (?, ?, ?, ?);

updateNombre:
UPDATE Nevera SET nombre = ? WHERE id = ?;

deleteById:
DELETE FROM Nevera WHERE id = ?;

-- Feeds the SyncManager: which fridges need a Firestore listener
selectSharedIds:
SELECT id FROM Nevera WHERE modo = 'SHARED';

updateModo:
UPDATE Nevera SET modo = ? WHERE id = ?;

-- Resets the sync watermark (e.g. when a fridge goes back to LOCAL)
clearSyncState:
UPDATE Nevera SET updated_at = NULL WHERE id = ?;

-- Used by the sync to apply remote changes with last-write-wins
updateFromRemote:
UPDATE Nevera SET nombre = ?, id_propietario = ?, updated_at = ? WHERE id = ?;

-- Hooks a remote (joined) fridge into the local mirror: the row is born in
-- SHARED mode so the SyncManager attaches its listener; updated_at stays
-- NULL until the first listener snapshot stamps the server watermark.
insertOrIgnoreFromRemote:
INSERT OR IGNORE INTO Nevera (id, nombre, id_propietario, fecha_creacion, modo, updated_at)
VALUES (?, ?, ?, ?, 'SHARED', NULL);
