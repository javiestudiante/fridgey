-- Almacén clave/valor LOCAL para ajustes del dispositivo (p. ej. el toggle
-- "avisos_caducidad"). LOCAL ONLY — nunca se sincroniza con Firestore.
-- Las queries (upsert / select por clave) se añaden en el HITO 2B.
CREATE TABLE Preferencia (
    clave TEXT NOT NULL PRIMARY KEY,
    valor TEXT NOT NULL
);
