CREATE TABLE IF NOT EXISTS Producto (
    id TEXT NOT NULL PRIMARY KEY,
    id_nevera TEXT NOT NULL,
    codigo_barras TEXT,
    nombre TEXT NOT NULL,
    categoria TEXT NOT NULL,
    fecha_caducidad INTEGER NOT NULL,  -- Unix timestamp (seconds, midnight UTC of expiry day)
    fecha_registro INTEGER NOT NULL,   -- Unix timestamp (seconds)
    imagen_url TEXT,
    cantidad REAL NOT NULL DEFAULT 1.0,                       -- amount of product (Double; supports 0.5 kg, 1.5 l, etc.)
    dias_aviso_antes INTEGER NOT NULL DEFAULT 3,              -- how many days before expiry the user wants to be warned
    unidad TEXT NOT NULL DEFAULT 'unidades',                  -- pairs with `cantidad`; canonical `valor` of the UnidadMedida enum
    updated_at INTEGER,  -- último serverTimestamp de Firestore aplicado (epoch seconds); NULL si nunca sincronizado
    fecha_caducidad_ultimo_aviso INTEGER,  -- LOCAL ONLY — dedup del aviso de caducidad (epoch sec, UTC-midnight); NULL = nunca avisado. Estado LOCAL: se excluye del mapper de Firestore (no se sincroniza)
    creado_por TEXT,  -- UID de quien creó el producto; viaja a Firestore como `creadoPor` (actor del fan-out de "producto añadido"). NULL en productos LOCAL antiguos / offline sin cuenta
    FOREIGN KEY (id_nevera) REFERENCES Nevera(id) ON DELETE CASCADE
);

-- Full-text search index over the free-text columns of Producto (name + category),
-- backing accent-insensitive product search (replaces the old LOWER(..) LIKE '%term%').
--
-- EXTERNAL CONTENT pattern (content='Producto'): the FTS table stores ONLY the inverted
-- index, never a copy of the rows — the actual text lives in Producto. content_rowid
-- maps each FTS document to a Producto row by its implicit integer rowid. We map to
-- `rowid` (not the PK) on purpose: Producto's PRIMARY KEY is `id TEXT`, and FTS5
-- external-content requires an INTEGER docid; Producto is not WITHOUT ROWID, so it has
-- the usual implicit integer rowid we hook into here and in the sync triggers below.
--
-- Tokenizer: unicode61 with `remove_diacritics 2` → case-folding + accent-insensitive,
-- so "platano" matches "plátano". `remove_diacritics 2` needs SQLite >= 3.27, which is
-- why Android bundles a modern SQLite via requery (framework SQLite at minSdk 24 is too
-- old); iOS system SQLite and the Xerial JVM driver are both new enough.
CREATE VIRTUAL TABLE ProductoFts USING fts5(
    nombre,
    categoria,
    content='Producto',
    content_rowid='rowid',
    tokenize='unicode61 remove_diacritics 2'
);

-- Keep ProductoFts in sync with Producto using the FTS5 external-content idiom:
-- inserts add a document; deletes/updates issue a special 'delete' command (which
-- needs the OLD column values to locate the index entries) before re-inserting.
CREATE TRIGGER Producto_fts_ai AFTER INSERT ON Producto BEGIN
    INSERT INTO ProductoFts(rowid, nombre, categoria)
    VALUES (new.rowid, new.nombre, new.categoria);
END;

CREATE TRIGGER Producto_fts_ad AFTER DELETE ON Producto BEGIN
    INSERT INTO ProductoFts(ProductoFts, rowid, nombre, categoria)
    VALUES ('delete', old.rowid, old.nombre, old.categoria);
END;

CREATE TRIGGER Producto_fts_au AFTER UPDATE ON Producto BEGIN
    INSERT INTO ProductoFts(ProductoFts, rowid, nombre, categoria)
    VALUES ('delete', old.rowid, old.nombre, old.categoria);
    INSERT INTO ProductoFts(rowid, nombre, categoria)
    VALUES (new.rowid, new.nombre, new.categoria);
END;

-- All products in a fridge, soonest to expire first
selectByNevera:
SELECT * FROM Producto
WHERE id_nevera = ?
ORDER BY fecha_caducidad ASC;

-- Products with days remaining calculated (negative = already expired)
selectByNeveraWithDaysRemaining:
SELECT *,
    CAST((fecha_caducidad - :ahora) / 86400 AS INTEGER) AS dias_restantes
FROM Producto
WHERE id_nevera = :neveraId
ORDER BY fecha_caducidad ASC;

-- Search by name or category, accent-insensitive, via the FTS5 index. Matching
-- against the table name (`ProductoFts MATCH :match`) queries ALL indexed columns
-- (nombre + categoria) by default, preserving the old "match name OR category"
-- behavior. Selecting `Producto.*` (not FTS columns) keeps the result type as the
-- Producto row the repository mapper already expects and avoids the FTS5
-- hidden-column mapping. :match is an already-prepared FTS5 MATCH string (the repo
-- handles tokenizing / escaping / prefix `*` — HITO 3). Ordering unchanged.
searchInNevera:
SELECT Producto.*
FROM ProductoFts
JOIN Producto ON ProductoFts.rowid = Producto.rowid
WHERE Producto.id_nevera = :neveraId
  AND ProductoFts MATCH :match
ORDER BY Producto.fecha_caducidad ASC;

selectById:
SELECT * FROM Producto WHERE id = ?;

insert:
INSERT INTO Producto (id, id_nevera, codigo_barras, nombre, categoria, fecha_caducidad, fecha_registro, imagen_url, cantidad, dias_aviso_antes, unidad, creado_por)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE Producto
SET nombre = ?, categoria = ?, fecha_caducidad = ?, imagen_url = ?, cantidad = ?, dias_aviso_antes = ?, unidad = ?
WHERE id = ?;

deleteById:
DELETE FROM Producto WHERE id = ?;

deleteByNevera:
DELETE FROM Producto WHERE id_nevera = ?;

countByNevera:
SELECT COUNT(*) FROM Producto WHERE id_nevera = ?;

-- Used purely as a SQLDelight Flow trigger: any insert/update/delete on
-- Producto invalidates this query and re-emits the Flow that watches it.
-- Lets observers across other tables (e.g. observeNeverasByUsuario, which
-- needs to recompute per-fridge product counts) react to ANY product
-- change, not just to changes inside a single fridge.
countAll:
SELECT COUNT(*) FROM Producto;

-- Count of products in a fridge expiring on or before :threshold (the
-- "por caducar" stat on the NeveraCard). :threshold is the epoch-seconds of
-- midnight-UTC of (today + N days), matching how fecha_caducidad is stored;
-- this therefore counts products with diasRestantes <= N (expired included).
countExpiringByNevera:
SELECT COUNT(*) FROM Producto
WHERE id_nevera = :neveraId AND fecha_caducidad <= :threshold;

-- Products expiring EXACTLY on :hoy across every fridge the user owns or
-- collaborates in — feeds the cross-fridge "caducan hoy" home banner. :hoy is
-- the epoch-seconds of midnight-UTC of today. Returns the product name and its
-- fridge name so the banner can build "N productos caducan hoy en {fridge}".
selectExpiringTodayForUsuario:
SELECT p.id AS id, p.id_nevera AS nevera_id, p.nombre AS producto_nombre, n.nombre AS nevera_nombre
FROM Producto p
INNER JOIN Nevera n ON p.id_nevera = n.id
WHERE p.fecha_caducidad = :hoy
  AND p.id_nevera IN (
      SELECT id FROM Nevera WHERE id_propietario = :usuarioId
      UNION
      SELECT id_nevera FROM NeveraColaborador WHERE id_usuario = :usuarioId
  )
ORDER BY p.nombre ASC;

-- insert-or-ignore + update pair the sync uses as an upsert (the SQLite
-- shipped with our minSdk doesn't support ON CONFLICT DO UPDATE). NOT an
-- INSERT OR REPLACE deliberately: REPLACE deletes + reinserts the row,
-- which would fire ON DELETE CASCADE triggers and reset unset columns.
insertFromRemote:
INSERT OR IGNORE INTO Producto (id, id_nevera, codigo_barras, nombre, categoria, fecha_caducidad, fecha_registro, imagen_url, cantidad, dias_aviso_antes, unidad, updated_at, creado_por)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateFromRemote:
UPDATE Producto
SET codigo_barras = ?, nombre = ?, categoria = ?, fecha_caducidad = ?, fecha_registro = ?, imagen_url = ?, cantidad = ?, dias_aviso_antes = ?, unidad = ?, updated_at = ?, creado_por = ?
WHERE id = ?;

-- TODOS los productos locales con sólo las columnas necesarias para construir
-- un ProductoParaAviso (barrido de avisos de caducidad, HITO 3). SIN filtro por
-- usuario a propósito: los avisos deben funcionar offline y sin cuenta, neveras
-- LOCAL incluidas. fecha_caducidad_ultimo_aviso es nullable (NULL = nunca avisado).
selectAllParaAviso:
SELECT id, id_nevera, nombre, fecha_caducidad, dias_aviso_antes, fecha_caducidad_ultimo_aviso
FROM Producto;

-- Writeback de dedup del aviso: fija SÓLO fecha_caducidad_ultimo_aviso. NO toca
-- updated_at deliberadamente — es estado LOCAL; arrastrar updated_at haría que el
-- SyncManager viese el producto como modificado y generase escrituras
-- espurias a Firestore.
marcarAvisado:
UPDATE Producto
SET fecha_caducidad_ultimo_aviso = ?
WHERE id = ?;
