CREATE TABLE IF NOT EXISTS Usuario (
    id TEXT NOT NULL PRIMARY KEY,
    email TEXT NOT NULL,
    nombre TEXT NOT NULL,
    proveedor TEXT NOT NULL,  -- 'google' or 'apple'
    foto_url TEXT,
    fecha_creacion INTEGER NOT NULL  -- Unix timestamp (seconds)
);

selectAll:
SELECT * FROM Usuario;

selectById:
SELECT * FROM Usuario WHERE id = ?;

insert:
INSERT OR REPLACE INTO Usuario (id, email, nombre, proveedor, foto_url, fecha_creacion)
VALUES (?, ?, ?, ?, ?, ?);

deleteById:
DELETE FROM Usuario WHERE id = ?;

-- Used by the sync to mirror denormalized profiles of remote collaborators
-- without clobbering the local user's own row (the `insert` above is
-- INSERT OR REPLACE and would overwrite the real email/proveedor).
insertOrIgnore:
INSERT OR IGNORE INTO Usuario (id, email, nombre, proveedor, foto_url, fecha_creacion)
VALUES (?, ?, ?, ?, ?, ?);

updateProfile:
UPDATE Usuario SET nombre = ?, foto_url = ? WHERE id = ?;
